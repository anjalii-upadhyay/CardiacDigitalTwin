# ── Logs ──────────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Node / Vite (React frontend) ──────────────────────────────────────────────
node_modules
dist
dist-ssr
*.local

