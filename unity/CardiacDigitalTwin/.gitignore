# Unity generated folders — all of these are rebuilt by the Editor on open.
# Library/ alone is ~3 GB; it must never be committed.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Aa]ssets/[Ss]creenshots/
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# Never commit the Asset Store cache
/[Aa]ssets/AssetStoreTools*

# Visual Studio / Rider / VS Code project files (regenerated)
.vs/
.vscode/
.idea/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Builds
*.apk
*.aab
*.unitypackage
*.app
